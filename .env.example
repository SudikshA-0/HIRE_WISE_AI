# Flask Configuration
FLASK_SECRET_KEY=super_secure_secret_key_change_in_production
FLASK_ENV=production

# Database Configuration
# Set DATABASE_URL to your Supabase PostgreSQL connection string for production
# Format: postgresql://postgres.xxxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///database/hirewise.db

# Supabase API Settings (optional metadata storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# AI Groq API Configuration
# Get your key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3

# Whisper Transcription model name (for offline fallbacks)
WHISPER_MODEL_NAME=tiny

# Optional HireWise MLOps service connection (dashboard degrades gracefully when unavailable)
HIREWISE_ML_SERVICE_URL=http://127.0.0.1:8000
HIREWISE_ML_TIMEOUT_SECONDS=2
HIREWISE_ML_API_KEY=

# MLOps service configuration (set for the FastAPI process)
MLFLOW_TRACKING_URI=http://127.0.0.1:6001
MLOPS_PREDICTION_DB=mlops/data/predictions.db
MLOPS_MONITORING_WINDOW_DAYS=30
